{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/page?slug=:slug"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "src/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/content?action=publish",
      "schedule": "5 12 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}
