{
  "rewrites": [
    {
      "source": "/api/threads-callback",
      "destination": "/api/threads?action=callback"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/page?seo=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?seo=sitemap"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?doc=privacy"
    },
    {
      "source": "/refund",
      "destination": "/api/page?doc=refund"
    },
    {
      "source": "/draft/:name",
      "destination": "/api/page?draft=:name"
    },
    {
      "source": "/order",
      "destination": "/api/page?view=order"
    },
    {
      "source": "/checkout",
      "destination": "/api/page?view=checkout"
    },
    {
      "source": "/review",
      "destination": "/api/page?review=1"
    },
    {
      "source": "/quiz",
      "destination": "/api/page?quiz=_index"
    },
    {
      "source": "/quiz/:slug",
      "destination": "/api/page?quiz=:slug"
    },
    {
      "source": "/learn",
      "destination": "/api/page?learn=_index"
    },
    {
      "source": "/learn/:slug",
      "destination": "/api/page?learn=:slug"
    },
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/page?slug=:slug"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "src/**"
    },
    "api/content.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/content?action=keepalive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/content?action=publish",
      "schedule": "5 12 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}